{
  "description": "phiward: the guard on every tool call, the check of each prompt before it is sent, and the start-of-session note",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/clean-exec.sh",
            "args": ["phiward", "hook", "claude"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/clean-exec.sh",
            "args": ["phiward", "session-note", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/clean-exec.sh",
            "args": ["phiward", "prompt-scan", "claude"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
