#!/usr/bin/env python3
# A made-up stand-in for sandbox-runtime's apply-seccomp, for `check.sh --stub` (Linux): it
# denies socket(AF_UNIX) with EPERM and io_uring with ENOSYS, then runs the command, so
# `phiward launch --tool claude` finds a filter that works. Usage: apply-seccomp CMD [ARG]...
import ctypes
import os
import platform
import struct
import sys

m = platform.machine()
arch = {"x86_64": 0xC000003E, "aarch64": 0xC00000B7}[m]
sock = 41 if m == "x86_64" else 198
ld, jeq, ret = 0x20, 0x15, 0x06
p = [(ld, 0, 0, 4), (jeq, 1, 0, arch), (ret, 0, 0, 0x80000000), (ld, 0, 0, 0)]
for n in (425, 426, 427):
    p += [(jeq, 0, 1, n), (ret, 0, 0, 0x50026)]
p += [(jeq, 0, 3, sock), (ld, 0, 0, 16), (jeq, 0, 1, 1), (ret, 0, 0, 0x50001),
      (ret, 0, 0, 0x7FFF0000)]
b = b"".join(struct.pack("<HBBI", *i) for i in p)
buf = ctypes.create_string_buffer(b, len(b))


class Prog(ctypes.Structure):
    _fields_ = [("len", ctypes.c_ushort), ("f", ctypes.c_void_p)]


fp = Prog(len(p), ctypes.cast(buf, ctypes.c_void_p))
libc = ctypes.CDLL(None, use_errno=True)
if libc.prctl(38, 1, 0, 0, 0) != 0 or libc.prctl(22, 2, ctypes.byref(fp), 0, 0) != 0:
    sys.exit("apply-seccomp (stand-in): the filter could not be set")
os.execvp(sys.argv[1], sys.argv[1:])
