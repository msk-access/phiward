#!/bin/sh
# A stand-in for `claude -p`, for `check.sh --stub` (the plumbing, never Claude Code itself): no
# model, no network, no sandbox of its own. It writes a stream-json transcript as Claude Code
# does: the init event (after it starts the wrapped MCP server from the config Claude Code would
# read), the UserPromptSubmit hooks on its prompt (a block ends the session there, with no turn,
# as Claude Code does), then what the prompt asks: a Read of ./target.txt and a Read of the
# protected file whose path it holds (each refused if a PreToolUse hook refuses it, as Claude
# Code runs the hooks, else read for real), then one Bash call of `sh ./probes.sh`, run with the
# credential variables removed (as CLAUDE_CODE_SUBPROCESS_ENV_SCRUB does); on Linux, while it
# runs, the mount points Claude Code's sandbox leaves on the host stand (an empty read-only file
# at the first missing part of each deny path). So in Mode A, where
# nothing confines it, the judge must see the holes; under `phiward launch` (Mode B) the kernel
# probes meet the real boundary. It cannot test the terminal prompt.
# launch reads its version from the package.json beside it (as for the npm build; it starts no
# script to ask), so it passes the Claude Code floor like the real one.
# Claude Code's native build is also its seccomp filter, run as itself with ARGV0=apply-seccomp
# (phiward launch probes it so on Linux): the stand-in's filter is the made-up one beside it
if [ "${ARGV0:-}" = apply-seccomp ]; then
  exec python3 "$(dirname "$0")/apply-seccomp" "$@"
fi
# `claude --help`, and `claude WORD --help` as Claude Code answers it: a Usage line of its own
# for a command, the root's for a prompt (phiward launch asks so below Landlock ABI 9)
if { [ "$#" = 1 ] && [ "$1" = --help ]; } || { [ "$#" = 2 ] && [ "$2" = --help ]; }; then
  if [ "$#" = 2 ] && [ "$1" = doctor ]; then
    echo "Usage: claude doctor [options] (stand-in)"
    exit 0
  fi
  echo "Usage: claude [options] [command] [prompt] (stand-in)"
  echo
  echo "Options:"
  for f in -p --model --output-format --verbose --settings --add-dir --allowedTools \
    --permission-prompts --permission-mode --max-turns --max-budget-usd; do echo "  $f"; done
  echo
  echo "Commands:"
  echo "  doctor                      Check the installation"
  exit 0
fi
case ${1:-} in
  --version) echo "2.1.327 (Claude Code stand-in)"; exit 0 ;;
esac
exec python3 - "$@" <<'PY'
import json, os, re, subprocess, sys

args = sys.argv[1:]
settings = [args[i + 1] for i, a in enumerate(args[:-1]) if a == "--settings"]
cwd = os.getcwd()


def emit(ev):
    print(json.dumps(ev), flush=True)


def load(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def matches(matcher, tool):
    """A hook matcher as Claude Code reads it: empty or * is every tool, else a regex (or a
    list split by |)."""
    if matcher in ("", "*"):
        return True
    try:
        return re.fullmatch(matcher, tool) is not None
    except re.error:
        return tool in matcher.split("|")


def run_hook(h, payload):
    """One hook as Claude Code runs it: the exec form (`command` and its `args`), else the
    command through a shell. Returns (exit code, stdout, stderr)."""
    if isinstance(h.get("args"), list):
        argv = [str(h["command"])] + [str(a) for a in h["args"]]
    else:
        argv = ["sh", "-c", h["command"]]
    try:
        r = subprocess.run(argv, input=payload.encode(), capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, b"", str(exc).encode()
    return r.returncode, r.stdout, r.stderr


def hooks_for(event, tool=None):
    for src in settings + [user]:
        for g in (load(src).get("hooks") or {}).get(event) or []:
            m = (g.get("matcher") or "") if isinstance(g, dict) else ""
            if tool is not None and not matches(m, tool):
                continue
            for h in (g.get("hooks") or []) if isinstance(g, dict) else []:
                if isinstance(h, dict) and h.get("command"):
                    yield h


prompt = next((args[i + 1] for i, a in enumerate(args[:-1]) if a == "-p"), "")
home = os.environ.get("HOME", "")
conf = os.environ.get("CLAUDE_CONFIG_DIR")
main = os.path.join(conf, ".claude.json") if conf else os.path.join(home, ".claude.json")
user = os.path.join(conf, "settings.json") if conf else os.path.join(home, ".claude", "settings.json")

# the wrapped MCP server, started as Claude Code starts it (stdin closed: it exits at once)
servers = []
for name, entry in (load(main).get("mcpServers") or {}).items():
    if not isinstance(entry, dict) or not entry.get("command"):
        continue
    try:
        r = subprocess.run([entry["command"]] + list(entry.get("args") or []),
                           env=dict(os.environ, **(entry.get("env") or {})),
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=60)
        status = "connected" if r.returncode == 0 else "failed"
    except (OSError, subprocess.SubprocessError):
        status = "failed"
    servers.append({"name": name, "status": status})
emit({"type": "system", "subtype": "init", "cwd": cwd, "model": "stub", "mcp_servers": servers,
      "tools": ["Bash", "Read"]})

# the prompt: every UserPromptSubmit hook; exit 2 or a "block" decision stops it unsent
payload = json.dumps({"session_id": "stub", "hook_event_name": "UserPromptSubmit",
                      "prompt": prompt, "cwd": cwd, "transcript_path": ""})
for h in hooks_for("UserPromptSubmit"):
    code, out, err = run_hook(h, payload)
    reason = err.decode(errors="replace").strip() if code == 2 else None
    if reason is None:
        try:
            got = json.loads(out or b"{}")
        except ValueError:
            got = {}
        if isinstance(got, dict) and got.get("decision") == "block":
            reason = str(got.get("reason", "blocked"))
    if reason is not None:
        emit({"type": "system", "subtype": "informational", "level": "warning",
              "content": "UserPromptSubmit operation blocked by hook:\n" + reason,
              "prevent_continuation": True})
        emit({"type": "result", "subtype": "success", "is_error": False, "num_turns": 0,
              "result": ""})
        sys.exit(0)

def refusal_of(tool, tool_input):
    """Every PreToolUse hook whose matcher covers `tool`, from each settings source, as Claude
    Code runs them: the first refusal's reason, or None."""
    payload = json.dumps({"session_id": "stub", "hook_event_name": "PreToolUse",
                          "tool_name": tool, "tool_input": tool_input, "cwd": cwd,
                          "transcript_path": ""})
    refusal = None
    for h in hooks_for("PreToolUse", tool):
        if refusal is not None:
            break
        code, out, err = run_hook(h, payload)
        if code == 2:
            refusal = err.decode(errors="replace").strip()
            continue
        try:
            got = json.loads(out or b"{}")
        except ValueError:
            got = {}
        spec = got.get("hookSpecificOutput") if isinstance(got, dict) else None
        if isinstance(spec, dict) and spec.get("permissionDecision") == "deny":
            refusal = str(spec.get("permissionDecisionReason", "denied"))
    return refusal


def read_tool(path, tid):
    """A Read as Claude Code makes it: the PreToolUse hooks, then the file. Returns the text
    read, or "" when refused or missing."""
    refusal = refusal_of("Read", {"file_path": path})
    emit({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": tid, "name": "Read", "input": {"file_path": path}}]}})
    text = ""
    if refusal is not None:
        result, err = "PreToolUse:Read hook error: " + refusal, True
    else:
        try:
            with open(path) as fh:
                text = fh.read()
            result, err = text, False
        except OSError as exc:
            result, err = ("File does not exist." if isinstance(exc, FileNotFoundError)
                           else f"Error: {exc.strerror}"), True
    emit({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": tid, "is_error": err, "content": result}]}})
    return text


# as the prompt asks: a Read of ./target.txt and one of the path it holds (the prompt names
# no protected path), then the Bash call
target = read_tool(os.path.join(cwd, "target.txt"), "stub-target").strip()
read_tool(target, "stub-read")

# the bypass probe's session (--permission-mode bypassPermissions): a Bash `cat` of that path,
# through the PreToolUse hooks as Claude Code runs them in every mode, and `env > env.txt`;
# then the session ends
mode = next((args[i + 1] for i, a in enumerate(args[:-1]) if a == "--permission-mode"), "")
if mode == "bypassPermissions":
    command = "cat " + target
    refusal = refusal_of("Bash", {"command": command})
    emit({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": "stub-cat", "name": "Bash", "input": {"command": command}}]}})
    if refusal is not None:
        result, err = "PreToolUse:Bash hook error: " + refusal, True
    else:
        r = subprocess.run(["cat", target], capture_output=True, timeout=30)
        result, err = (r.stdout + r.stderr).decode(errors="replace")[-2000:], r.returncode != 0
    emit({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": "stub-cat", "is_error": err, "content": result}]}})
    # then `env > env.txt`, with the credentials scrubbed (launch.py looks for the token in it)
    emit({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": "stub-env", "name": "Bash",
         "input": {"command": "env > env.txt"}}]}})
    scrubbed = {k: v for k, v in os.environ.items()
                if k not in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
    r = subprocess.run(["sh", "-c", "env > env.txt"], env=scrubbed, capture_output=True, timeout=30)
    emit({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": "stub-env", "is_error": r.returncode != 0,
         "content": ""}]}})
    emit({"type": "result", "subtype": "success", "is_error": False, "result": "DONE"})
    sys.exit(0)

# the Bash call, with the credentials scrubbed from its environment
emit({"type": "assistant", "message": {"content": [
    {"type": "tool_use", "id": "stub-bash", "name": "Bash",
     "input": {"command": "sh ./probes.sh"}}]}})
env = {k: v for k, v in os.environ.items()
       if k not in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}


def mount_points():
    """What Claude Code's sandbox leaves on the host while a command runs, on Linux: for a
    sandbox.filesystem deny path that does not exist, its first missing part, made as an empty
    read-only file (the mount point that blocks its creation), where the host lets it be made.
    Removed after the command, as Claude Code removes them. The paths made."""
    if not sys.platform.startswith("linux"):
        return []
    deny = []
    for path in [user] + settings:
        fs = (load(path).get("sandbox") or {}).get("filesystem") or {}
        for key in ("denyRead", "denyWrite"):
            deny += [str(p) for p in fs.get(key) or [] if isinstance(p, str)]
    made = []
    for p in deny:
        p = home + p[1:] if p == "~" or p.startswith("~/") else p
        if not p.startswith("/") or any(c in p for c in "*?["):
            continue
        part = ""
        for name in p.strip("/").split("/"):
            part += "/" + name
            if not os.path.lexists(part):
                try:
                    os.close(os.open(part, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o444))
                    made.append(part)
                except OSError:
                    pass
                break
    return made


made = mount_points()
try:
    r = subprocess.run(["sh", "./probes.sh"], env=env, capture_output=True, timeout=240)
finally:
    for part in made:
        try:
            os.unlink(part)
        except OSError:
            pass
emit({"type": "user", "message": {"content": [
    {"type": "tool_result", "tool_use_id": "stub-bash", "is_error": r.returncode != 0,
     "content": (r.stdout + r.stderr).decode(errors="replace")[-2000:]}]}})
emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "DONE"}]}})
emit({"type": "result", "subtype": "success", "is_error": False, "result": "DONE"})
PY
